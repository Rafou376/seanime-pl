{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "include": [
        "src/onlinestream/**/payload.ts",
        "src/_shared/onlinestream/**/*.ts",
        "src/_shared/onlinestream/**/*.d.ts",
        "bundle.ts",
        "scripts/**/*.ts"
    ]
}
